#!/bin/sh

_xfer_cleanup() {
  _xfer_stop_wait_watchdog
  trap - 0 HUP INT TERM ALRM
  _xfer_finish_progress
  if [ -n "${tty_state:-}" ] && [ "${tty_open:-0}" -eq 1 ]; then
    stty "$tty_state" <&3 2>/dev/null ||
      printf '%s\n' "xfer: could not restore terminal settings; run 'stty sane'" >&2
  fi
  if [ "${tty_open:-0}" -eq 1 ]; then
    exec 3>&-
    tty_open=0
  fi
  [ -z "${archive:-}" ] || rm -f "$archive"
  [ -z "${encoded_archive:-}" ] || rm -f "$encoded_archive"
  [ -z "${tar_status_path:-}" ] || rm -f "$tar_status_path"
}

_xfer_interrupted() {
  trap - HUP INT TERM
  if [ -n "${id:-}" ] && [ "${tty_open:-0}" -eq 1 ]; then
    _xfer_resync || :
    _xfer_emit "X|$id|remote_interrupted" || :
  fi
  exit 130
}

_xfer_stop_wait_watchdog() {
  [ -n "${wait_watchdog_pid:-}" ] || return 0
  kill "$wait_watchdog_pid" 2>/dev/null || :
  wait "$wait_watchdog_pid" 2>/dev/null || :
  wait_watchdog_pid=
}

_xfer_disarm_wait_timeout() {
  _xfer_stop_wait_watchdog
  if [ "${read_timeout_supported:-0}" -ne 1 ]; then trap - ALRM; fi
}

_xfer_is_sha256() {
  [ "${#1}" -eq 64 ] || return 1
  case $1 in
    *[!0-9A-Fa-f]*) return 1 ;;
    *) return 0 ;;
  esac
}

_xfer_is_uint() {
  case $1 in
    '' | *[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

_xfer_now() {
  date +%s
}

_xfer_mktemp() {
  mktemp "${TMPDIR:-/tmp}/xfer.XXXXXXXXXX" || {
    printf '%s\n' 'Could not create a temporary file' >&2
    return 1
  }
}

_xfer_sha256() {
  _xfer_hash_output=
  _xfer_hash_path=${1:-}
  case $hasher in
    sha256sum) set -- sha256sum ;;
    shasum) set -- shasum -a 256 ;;
    openssl) set -- openssl dgst -sha256 ;;
  esac
  if [ -n "$_xfer_hash_path" ]; then
    _xfer_hash_output=$("$@" "$_xfer_hash_path") || return
  else
    _xfer_hash_output=$("$@") || return
  fi
  _xfer_hash_digest=${_xfer_hash_output##*= }
  _xfer_hash_digest=${_xfer_hash_digest%%[[:space:]]*}
  _xfer_is_sha256 "$_xfer_hash_digest" || return 1
  printf '%s' "$_xfer_hash_digest" | tr 'A-F' 'a-f'
}

_xfer_format_bytes() {
  _xfer_fb_bytes=$1
  _xfer_fb_unit=0
  _xfer_fb_divisor=1
  while [ "$_xfer_fb_unit" -lt 4 ] &&
    [ "$_xfer_fb_bytes" -ge $((_xfer_fb_divisor * 1024)) ]; do
    _xfer_fb_unit=$((_xfer_fb_unit + 1))
    _xfer_fb_divisor=$((_xfer_fb_divisor * 1024))
  done
  case $_xfer_fb_unit in
    0)
      _xfer_format_result="$_xfer_fb_bytes B"
      return
      ;;
    1) _xfer_fb_name=KiB ;;
    2) _xfer_fb_name=MiB ;;
    3) _xfer_fb_name=GiB ;;
    4) _xfer_fb_name=TiB ;;
  esac
  _xfer_fb_scaled=$((_xfer_fb_bytes * 10 / _xfer_fb_divisor))
  _xfer_format_result="$((_xfer_fb_scaled / 10)).$((_xfer_fb_scaled % 10)) $_xfer_fb_name"
}

_xfer_format_duration() {
  _xfer_fd_hours=$(($1 / 3600))
  _xfer_fd_minutes=$(($1 / 60 % 60))
  _xfer_fd_seconds=$(($1 % 60))
  [ "$_xfer_fd_hours" -ge 10 ] || _xfer_fd_hours=0$_xfer_fd_hours
  [ "$_xfer_fd_minutes" -ge 10 ] || _xfer_fd_minutes=0$_xfer_fd_minutes
  [ "$_xfer_fd_seconds" -ge 10 ] || _xfer_fd_seconds=0$_xfer_fd_seconds
  _xfer_format_result="$_xfer_fd_hours:$_xfer_fd_minutes:$_xfer_fd_seconds"
}

_xfer_report_progress() {
  _xfer_rp_current=$1
  _xfer_rp_total=$2
  _xfer_rp_start=$3
  _xfer_rp_now=${4:-}
  if [ -z "$_xfer_rp_now" ]; then
    _xfer_rp_now=$(_xfer_now) || _xfer_rp_now=$_xfer_rp_start
  fi
  _xfer_rp_elapsed=$((_xfer_rp_now - _xfer_rp_start))
  _xfer_rp_delta_time=$((_xfer_rp_now - progress_time))
  _xfer_rp_delta_bytes=$((_xfer_rp_current - progress_bytes))
  if [ "$_xfer_rp_elapsed" -gt 0 ]; then _xfer_rp_average_speed=$((_xfer_rp_current / _xfer_rp_elapsed)); else _xfer_rp_average_speed=0; fi
  if [ "$_xfer_rp_delta_time" -gt 0 ] && [ "$_xfer_rp_delta_bytes" -gt 0 ]; then
    _xfer_rp_speed=$((_xfer_rp_delta_bytes / _xfer_rp_delta_time))
  else
    _xfer_rp_speed=$_xfer_rp_average_speed
  fi
  if [ "$_xfer_rp_total" -gt "$_xfer_rp_current" ]; then _xfer_rp_remaining=$((_xfer_rp_total - _xfer_rp_current)); else _xfer_rp_remaining=0; fi
  if [ "$_xfer_rp_average_speed" -gt 0 ]; then
    _xfer_format_duration "$((_xfer_rp_remaining / _xfer_rp_average_speed))"
    _xfer_rp_eta=$_xfer_format_result
  else
    _xfer_rp_eta=--:--:--
  fi
  if [ "$_xfer_rp_total" -gt 0 ]; then _xfer_rp_percent=$((_xfer_rp_current * 1000 / _xfer_rp_total)); else _xfer_rp_percent=0; fi
  [ "$_xfer_rp_percent" -le 1000 ] || _xfer_rp_percent=1000

  _xfer_format_bytes "$_xfer_rp_current"
  _xfer_rp_current_text=$_xfer_format_result
  _xfer_format_bytes "$_xfer_rp_total"
  _xfer_rp_total_text=$_xfer_format_result
  _xfer_format_bytes "$_xfer_rp_speed"
  _xfer_rp_speed_text=$_xfer_format_result
  _xfer_format_duration "$_xfer_rp_elapsed"
  _xfer_rp_elapsed_text=$_xfer_format_result
  if [ -t 1 ]; then
    printf '\r\033[2K%s / %s (%d.%d%%) | %s/s | elapsed %s | ETA %s' \
      "$_xfer_rp_current_text" "$_xfer_rp_total_text" \
      "$((_xfer_rp_percent / 10))" "$((_xfer_rp_percent % 10))" \
      "$_xfer_rp_speed_text" "$_xfer_rp_elapsed_text" "$_xfer_rp_eta"
  else
    printf '%s / %s (%d.%d%%) | %s/s | elapsed %s | ETA %s\n' \
      "$_xfer_rp_current_text" "$_xfer_rp_total_text" \
      "$((_xfer_rp_percent / 10))" "$((_xfer_rp_percent % 10))" \
      "$_xfer_rp_speed_text" "$_xfer_rp_elapsed_text" "$_xfer_rp_eta"
  fi
  progress_bytes=$_xfer_rp_current
  progress_time=$_xfer_rp_now
}

_xfer_finish_progress() {
  if [ "${progress_active:-0}" -eq 1 ] && [ -t 1 ]; then printf '\n'; fi
  progress_active=0
}

_xfer_osc() {
  if [ "${force_tmux:-0}" -eq 1 ] || [ -n "${TMUX:-}" ]; then
    printf '\033Ptmux;\033\033]1337;SetUserVar=wezterm_transfer=%s\007\033\134' "$1" >&3
  else
    printf '\033]1337;SetUserVar=wezterm_transfer=%s\007' "$1" >&3
  fi
}

_xfer_emit() {
  _xfer_emit_encoded=$(printf '%s' "$1" | base64) || return
  _xfer_emit_encoded=$(printf '%s' "$_xfer_emit_encoded" | tr -d '\r\n') || return
  [ -n "$_xfer_emit_encoded" ] || return 1
  _xfer_osc "$_xfer_emit_encoded"
}

_xfer_resync() {
  [ "${tty_open:-0}" -eq 1 ] || return 1
  printf '\030' >&3 || return
  _xfer_osc ''
}

_xfer_prepare_tmux() {
  [ -n "${TMUX:-}" ] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  tmux set-option -g allow-passthrough all >/dev/null 2>&1 || :
}

_xfer_cleanup_stale_remote_uploads() {
  _xfer_stale_now=$(_xfer_now) || return
  for _xfer_stale_lease in ./.wezterm-xfer-*.lease; do
    [ -f "$_xfer_stale_lease" ] || continue
    IFS= read -r _xfer_stale_deadline <"$_xfer_stale_lease" || _xfer_stale_deadline=
    if ! _xfer_is_uint "$_xfer_stale_deadline" ||
      [ "$_xfer_stale_now" -ge "$_xfer_stale_deadline" ]; then
      _xfer_stale_prefix=${_xfer_stale_lease%.lease}
      rm -f "$_xfer_stale_prefix.tar.gz.part" \
        "$_xfer_stale_prefix.lease" "$_xfer_stale_prefix.lease.tmp"
      rm -rf "$_xfer_stale_prefix.extract.part"
    fi
  done
}

_xfer_has_timed_read() (
  exec 2>/dev/null
  # shellcheck disable=SC3045
  IFS= read -r -t 0 _xfer_read_probe </dev/null
  case $? in 0 | 1) exit 0 ;; *) exit 1 ;; esac
)

_xfer_read_wait_line() {
  if [ "${read_timeout_supported:-0}" -eq 1 ]; then
    _xfer_read_now=$(_xfer_now) || return 1
    _xfer_read_remaining=$((_xfer_wait_deadline - _xfer_read_now))
    [ "$_xfer_read_remaining" -gt 0 ] || return 124
    # shellcheck disable=SC3045
    if IFS= read -r -t "$_xfer_read_remaining" _xfer_wait_line <&3; then return 0; fi
    _xfer_read_now=$(_xfer_now) || return 1
    [ "$_xfer_read_now" -lt "$_xfer_wait_deadline" ] || return 124
    return 1
  fi

  IFS= read -r _xfer_wait_line <&3
  _xfer_read_status=$?
  [ "${_xfer_wait_timed_out:-0}" -eq 0 ] || return 124
  return "$_xfer_read_status"
}

_xfer_wait() {
  _xfer_wait_expected=$1
  _xfer_wait_timeout=${2:-30}
  _xfer_wait_ack="#WTX1|A|$id|$_xfer_wait_expected|"
  _xfer_wait_cancel="#WTX1|C|$id|"
  _xfer_wait_timed_out=0
  _xfer_wait_deadline=$(_xfer_now) || return 1
  _xfer_wait_deadline=$((_xfer_wait_deadline + _xfer_wait_timeout))
  if [ "${read_timeout_supported:-0}" -ne 1 ]; then
    trap '_xfer_wait_timed_out=1' ALRM
    (
      trap - 0 HUP INT TERM ALRM
      sleep "$_xfer_wait_timeout"
      kill -s ALRM "$$" 2>/dev/null
    ) &
    wait_watchdog_pid=$!
  fi
  while :; do
    _xfer_read_wait_line
    case $? in
      0) ;;
      124) _xfer_wait_timed_out=1; break ;;
      *) break ;;
    esac
    case $_xfer_wait_line in
      " #WTX1|"*) _xfer_wait_line=${_xfer_wait_line# } ;;
    esac
    case $_xfer_wait_line in
      "$_xfer_wait_ack"*)
        _xfer_disarm_wait_timeout
        return 0
        ;;
      "$_xfer_wait_cancel"*)
        _xfer_wait_reason=${_xfer_wait_line#"$_xfer_wait_cancel"}
        _xfer_wait_reason=${_xfer_wait_reason%%|*}
        [ -n "$_xfer_wait_reason" ] || _xfer_wait_reason=cancelled
        printf 'Transfer declined or cancelled by WezTerm: %s\n' \
          "$_xfer_wait_reason" >&2
        _xfer_disarm_wait_timeout
        return 2
        ;;
    esac
  done
  _xfer_disarm_wait_timeout
  if [ "$_xfer_wait_timed_out" -eq 1 ]; then
    _xfer_resync || :
    _xfer_emit "X|$id|ack_timeout" || :
    printf 'Timed out after %s seconds waiting for WezTerm\n' "$_xfer_wait_timeout" >&2
    return 124
  fi
  _xfer_emit "X|$id|terminal_closed" || :
  printf '%s\n' 'Terminal input closed while waiting for WezTerm' >&2
  return 1
}

_xfer_usage() {
  printf '%s\n' \
    'Usage: xfer [--tmux] [--] [PATH...]' \
    'With paths, download them to WezTerm. With no path, upload a host path here.'
}

_xfer_tty_available() (
  : 3<>/dev/tty
)

xfer_main() {
  archive=
  encoded_archive=
  tar_status_path=
  tty_state=
  tty_open=0
  wait_watchdog_pid=
  read_timeout_supported=0
  id=
  hasher=
  seq=0
  force_tmux=0
  chunk_size=8192
  accept_timeout=${XFER_ACCEPT_TIMEOUT:-120}
  ack_timeout=${XFER_ACK_TIMEOUT:-30}
  progress_active=0
  progress_bytes=0
  progress_time=0
  upload_request=0

  trap '_xfer_cleanup' 0
  trap '_xfer_interrupted' HUP INT TERM

  if _xfer_has_timed_read; then read_timeout_supported=1; fi

  if ! _xfer_is_uint "$accept_timeout" || [ "$accept_timeout" -eq 0 ] ||
    ! _xfer_is_uint "$ack_timeout" || [ "$ack_timeout" -eq 0 ]; then
    printf '%s\n' 'XFER_ACCEPT_TIMEOUT and XFER_ACK_TIMEOUT must be positive integers' >&2
    return 2
  fi

  while [ "$#" -gt 0 ]; do
    case $1 in
      -h | --help) _xfer_usage; return ;;
      --tmux) force_tmux=1; shift ;;
      --) shift; break ;;
      -*) printf 'Unknown option: %s\n' "$1" >&2; _xfer_usage >&2; return 2 ;;
      *) break ;;
    esac
  done
  if [ "$#" -eq 0 ]; then upload_request=1; fi

  _xfer_prepare_tmux

  required_commands='base64 date gzip mkdir mv rm sleep tar tr'
  if [ "$upload_request" -ne 1 ]; then required_commands="$required_commands fold mktemp stty wc"; fi
  for required in $required_commands; do
    command -v "$required" >/dev/null 2>&1 || {
      printf "xfer requires '%s' on the remote host\n" "$required" >&2
      return 127
    }
  done
  for required in sha256sum shasum openssl; do
    if command -v "$required" >/dev/null 2>&1; then
      hasher=$required
      break
    fi
  done
  if [ -z "$hasher" ]; then
    printf '%s\n' \
      "xfer requires 'sha256sum', 'shasum', or 'openssl' on the remote host" >&2
    return 127
  fi
  _xfer_cleanup_stale_remote_uploads

  id_time=$(_xfer_now) || {
    printf '%s\n' 'Could not read the current time' >&2
    return 1
  }
  id=$$-$id_time
  # shellcheck disable=SC3028
  host_label=${HOSTNAME:-${HOST:-remote}}
  label="${USER:-?}@$host_label:$PWD"
  label=$(printf '%s' "$label" | tr '\r\n|' '  _') || return
  label=$(printf '%.200s' "$label")

  if [ "$upload_request" -eq 1 ]; then
    if ! _xfer_tty_available 2>/dev/null; then
      printf '%s\n' 'Could not open terminal /dev/tty' >&2
      return 1
    fi
    exec 3<>/dev/tty
    tty_open=1
    passthrough=0
    if [ "$force_tmux" -eq 1 ] || [ -n "${TMUX:-}" ]; then passthrough=1; fi
    printf '%s\n' 'Choose a host path in WezTerm to upload here...'
    _xfer_resync || {
      printf '%s\n' 'Could not reset the terminal transfer state' >&2
      return 1
    }
    _xfer_emit "U|$id|$passthrough|$label" || {
      printf '%s\n' 'Could not contact WezTerm' >&2
      return 1
    }
    return
  fi

  if [ "$#" -eq 1 ]; then
    stem=${1%/}
    stem=${stem##*/}
  else
    stem=${PWD##*/}
  fi
  stem=$(printf '%s' "$stem" | tr -c 'A-Za-z0-9._-' '_') || return
  case $stem in
    '' | . | ..) stem=archive ;;
  esac
  stem=$(printf '%.190s' "$stem")
  name=$stem.tar.gz

  archive=$(_xfer_mktemp) || return 1
  encoded_archive=$(_xfer_mktemp) || return 1
  tar_status_path=$(_xfer_mktemp) || return 1

  printf '%s\n' 'Preparing archive...'
  if ! gzip -n -c </dev/null >/dev/null 2>&1; then
    printf '%s\n' "xfer requires gzip with deterministic '-n' support" >&2
    return 127
  fi
  {
    tar -cf - -- "$@"
    printf '%s\n' "$?" >"$tar_status_path"
  } | gzip -n -c >"$archive"
  gzip_status=$?
  tar_status=
  IFS= read -r tar_status <"$tar_status_path" || tar_status=
  if ! _xfer_is_uint "$tar_status" || [ "$tar_status" -ne 0 ] ||
    [ "$gzip_status" -ne 0 ]; then
    printf '%s\n' 'Could not create archive' >&2
    return 1
  fi
  archive_sha256=$(_xfer_sha256 "$archive") || {
    printf '%s\n' 'Could not calculate archive SHA-256' >&2
    return 1
  }
  total_bytes=$(wc -c <"$archive") || total_bytes=
  total_bytes=$(printf '%s' "$total_bytes" | tr -d '[:space:]')
  _xfer_is_uint "$total_bytes" || {
    printf '%s\n' 'Could not calculate archive size' >&2
    return 1
  }
  if ! _xfer_tty_available 2>/dev/null; then
    printf '%s\n' 'Could not open terminal /dev/tty' >&2
    return 1
  fi
  exec 3<>/dev/tty
  tty_open=1
  tty_state=$(stty -g <&3 2>/dev/null) || {
    printf '%s\n' 'Could not read terminal settings' >&2
    return 1
  }
  stty -echo icanon -inlcr -igncr icrnl <&3 2>/dev/null || {
    printf '%s\n' 'Could not configure terminal input' >&2
    return 1
  }

  printf '%s\n' 'Waiting for WezTerm to accept (Ctrl-C to cancel)...'
  _xfer_resync || {
    printf '%s\n' 'Could not reset the terminal transfer state' >&2
    return 1
  }
  _xfer_emit "B|$id|$name|$total_bytes|$archive_sha256|$label" || {
    printf '%s\n' 'Could not contact WezTerm' >&2
    return 1
  }
  _xfer_wait 0 "$accept_timeout" || return
  if ! base64 <"$archive" | tr -d '\r\n' | fold -w "$chunk_size" >"$encoded_archive"; then
    _xfer_emit "X|$id|encode_failed" || :
    printf '%s\n' 'Could not encode archive' >&2
    return 1
  fi

  printf 'Sending %s (%s bytes)...\n' "$name" "$total_bytes"
  transfer_start=$(_xfer_now) || transfer_start=$id_time
  progress_time=$transfer_start
  progress_active=1
  transferred_bytes=0
  _xfer_report_progress "$transferred_bytes" "$total_bytes" "$transfer_start" "$transfer_start"
  while IFS= read -r chunk || [ -n "$chunk" ]; do
    seq=$((seq + 1))
    _xfer_emit "D|$id|$seq|$chunk" || {
      printf '%s\n' 'Could not write transfer data to the terminal' >&2
      return 1
    }
    _xfer_wait "$seq" "$ack_timeout" || return
    _xfer_decoded_result=$((${#chunk} * 3 / 4))
    case $chunk in
      *==) _xfer_decoded_result=$((_xfer_decoded_result - 2)) ;;
      *=) _xfer_decoded_result=$((_xfer_decoded_result - 1)) ;;
    esac
    transferred_bytes=$((transferred_bytes + _xfer_decoded_result))
    progress_now=$(_xfer_now) || progress_now=$progress_time
    if [ "$((progress_now - progress_time))" -ge 1 ]; then
      _xfer_report_progress "$transferred_bytes" "$total_bytes" "$transfer_start" "$progress_now"
    fi
  done <"$encoded_archive"

  _xfer_emit "E|$id|$seq" || {
    printf '%s\n' 'Could not finish transfer' >&2
    return 1
  }
  _xfer_wait E "$ack_timeout" || return
  progress_now=$(_xfer_now) || progress_now=$progress_time
  _xfer_report_progress "$total_bytes" "$total_bytes" "$transfer_start" "$progress_now"
  _xfer_finish_progress
  printf 'Transferred %s as %s (SHA-256 verified)\n' "$*" "$name"
}

xfer_main "$@"
