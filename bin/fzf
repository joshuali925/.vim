#!/usr/bin/env bash
source ~/.vim/bin/_install_from_github.sh
if [[ -z $BIN_INIT && ( ! -s ~/.vim/config/fzf/shell.bash || ! -x ~/.local/bin/fzf ) ]]; then
  bash_filters=(-e 's/^### completion.bash ###$/[[ -z $BASH_COMPLETION_LOADED ]] \&\& return/')
  if [[ -n $NIU_SHELL ]]; then bash_filters+=(-e 's/READLINE_POINT=0x7fffffff/READLINE_POINT=2147483647/'); fi  # niubash reads READLINE_POINT as decimal
  BIN_INIT=1 fzf --bash | sed "${bash_filters[@]}" > ~/.vim/config/fzf/shell.bash || true
  BIN_INIT=1 fzf --zsh > ~/.vim/config/fzf/shell.zsh || true
fi

install-from-github fzf junegunn/fzf linux_amd64 linux_arm64 darwin_amd64 darwin_arm64 '' "$@"
