#!/usr/bin/env bash
source ~/.vim/bin/_install_from_github.sh
if [[ ! ~/.config/tmux/tmux.conf -ef ~/.vim/config/.tmux.conf ]]; then
  [[ -f $HOME/.config/tmux/tmux.conf ]] && echo '~/.config/tmux/tmux.conf exists, renaming to ~/.config/tmux/tmux.conf.bak' >&2 && mv -iv ~/.config/tmux/tmux.conf ~/.config/tmux/tmux.conf.bak
  mkdir -p ~/.config/tmux && ln -sv ~/.vim/config/.tmux.conf ~/.config/tmux/tmux.conf
fi

export LANG=en_US.UTF-8  # LANG is empty on some (RedHat) distros, set it to allow unicode/nerdfont display when called using st()
install-from-github tmux tmux/tmux-builds linux-x86_64 linux-arm64 macos-x86_64 macos-arm64 tmux "$@"
