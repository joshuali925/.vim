#!/usr/bin/env bash
set -euo pipefail

tmux_path=$(builtin command -v tmux)
[[ $tmux_path = */.vim/*/tmux ]] && echo 'Tmux not installed.' >&2 && exit 1

if [[ ! ~/.config/tmux/tmux.conf -ef ~/.vim/config/.tmux.conf ]]; then
  [[ -f ~/.config/tmux/tmux.conf ]] && echo '~/.config/tmux/tmux.conf exists, renaming to ~/.config/tmux/tmux.conf.bak' >&2 && mv -iv ~/.config/tmux/tmux.conf ~/.config/tmux/tmux.conf.bak
  mkdir -p ~/.config/tmux && ln -sv ~/.vim/config/.tmux.conf ~/.config/tmux/tmux.conf
fi
exec tmux "$@"
